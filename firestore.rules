rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile; admins can read all
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
      // Admins can update role field
      allow update: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // Progress: owner (and admins) read; owner writes only source-of-truth facts.
    // xp / level / levelName / coins are DERIVED on read by the app and must
    // never be changed by a client write — this blocks tampering (e.g. editing
    // localStorage or writing arbitrary XP straight to Firestore).
    match /progress/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == uid &&
        derivedFieldsFrozen() &&
        factsWellFormed();
    }

    // Derived scoreboard fields may not change value on a write. Because the app
    // uses a merge write that never sends these fields, the pre-existing value is
    // preserved and this passes; any attempt to raise them is rejected.
    function derivedFieldsFrozen() {
      let incoming = request.resource.data;
      let prevXp        = resource == null ? 0 : resource.data.get('xp', 0);
      let prevLevel     = resource == null ? 1 : resource.data.get('level', 1);
      let prevCoins     = resource == null ? 0 : resource.data.get('coins', 0);
      let prevLevelName = resource == null ? 'Iniciante' : resource.data.get('levelName', 'Iniciante');
      return incoming.get('xp', 0)        == prevXp &&
             incoming.get('level', 1)     == prevLevel &&
             incoming.get('coins', 0)     == prevCoins &&
             incoming.get('levelName', 'Iniciante') == prevLevelName;
    }

    // Progress facts must be well-formed and can only grow (nothing is un-earned).
    function factsWellFormed() {
      let d = request.resource.data;
      return d.completedEncounters is list && d.completedEncounters.size() <= 100 &&
             d.badges is list && d.badges.size() <= 30 &&
             (resource == null ||
               (d.completedEncounters.size() >= resource.data.completedEncounters.size() &&
                d.badges.size() >= resource.data.badges.size()));
    }

    // Settings are read by all authenticated users, written only by admins
    match /settings/{document} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Challenge submissions: students submit their own; admins review all
    match /submissions/{id} {
      // Owner reads their own; admins read the whole queue.
      // The doc id is `{uid}_{slug}`, so we authorize by id prefix — this also
      // permits reading a not-yet-existing submission (resource == null).
      allow read: if request.auth != null &&
        (isAdmin() || id.split('_')[0] == request.auth.uid);

      // Student creates a pending submission for themselves
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Student may re-submit their own (e.g. after a rejection), always as pending
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Admins approve / reject / clean up
      allow update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
