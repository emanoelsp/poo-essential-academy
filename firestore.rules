rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile; admins can read all
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
      // Admins can update role field
      allow update: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // Users can read/write only their own progress
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Settings are read by all authenticated users, written only by admins
    match /settings/{document} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Challenge submissions: students submit their own; admins review all
    match /submissions/{id} {
      // Owner reads their own; admins read the whole queue.
      // The doc id is `{uid}_{slug}`, so we authorize by id prefix — this also
      // permits reading a not-yet-existing submission (resource == null).
      allow read: if request.auth != null &&
        (isAdmin() || id.split('_')[0] == request.auth.uid);

      // Student creates a pending submission for themselves
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Student may re-submit their own (e.g. after a rejection), always as pending
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Admins approve / reject / clean up
      allow update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
